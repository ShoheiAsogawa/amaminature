# フロントエンドのビルド時の環境変数（Vite）。サーバー側の設定は wrangler.toml と .dev.vars.example を参照
# LINE Developers で発行した LIFF ID（未設定ならLINE外の「デモモード」で動く）
VITE_LIFF_ID=
# 公式アカウントの友だち追加URL（例: https://lin.ee/xxxxxxx）
VITE_LINE_ADD_FRIEND_URL=
# 空のままにする（アプリと API は同じ Worker・同じオリジンで配信する）。
# 別オリジンに置くには Worker に CORS の設定を足す必要がある（いまは入っていない）
VITE_API_BASE=
