{
  "name": "amami-nature",
  "private": true,
  "version": "0.1.0",
  "description": "奄美いきものコレクション — 奄美群島の生き物を撮って、名前をつけて、集める図鑑アプリ (Amalink)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "icons:ui": "node scripts/build-ui-icons.mjs",
    "contrast": "node scripts/contrast.mjs",
    "check:sil": "node scripts/check-silhouettes.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:demo": "DEMO_BUILD=1 vite build --outDir dist-demo",
    "dev:worker": "wrangler dev --local --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply amami-nature --local",
    "deploy": "npm run build && wrangler deploy",
    "richmenu": "node scripts/line-richmenu.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "e2e": "node scripts/e2e-capture.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@line/liff": "2.31.1",
    "@number-flow/react": "0.6.2",
    "budoux": "0.9.2",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exifr": "7.1.3",
    "framer-motion": "11.18.2",
    "hono": "4.13.12",
    "idb": "8.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.0",
    "zustand": "5.0.15",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@cloudflare/workers-types": "5.20260930.2",
    "@iconify-json/ph": "1.2.2",
    "@playwright/test": "1.64.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.15.30",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "3.2.7",
    "wrangler": "4.145.0"
  }
}
